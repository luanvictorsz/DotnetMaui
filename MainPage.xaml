<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CursoMaui.MainPage"
             BackgroundColor="#fff"
             Title="MainPage">
    <VerticalStackLayout 
        VerticalOptions="Center" 
        HorizontalOptions="Center">
        <Image 
            Source="lucknumber.png" 
            WidthRequest="74" 
            HeightRequest="115">
        </Image>
        <Label 
            Margin="0, 20, 0, 120" 
            Text="Número da Sorte"
            TextColor="#00AB37"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button Text="Gerar número da sorte" HorizontalOptions="Center"></Button>
        
    </VerticalStackLayout>
</ContentPage>